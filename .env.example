# GAL CRM — environment variables template.
# This file documents variable NAMES only. It contains no real values and
# is safe to commit. Copy it to .env.local (gitignored) and fill in real
# values there — never edit this file with real credentials.
#
# Where to get these values:
#   Supabase Dashboard -> select the GAL-CRM project -> Project Settings
#   -> API. Copy the "Project URL" and the anon/public key (labelled
#   "anon" / "public" or "Publishable key" depending on your dashboard
#   version — NOT the "service_role" / "secret" key).
#
# These are safe to expose to the browser (hence NEXT_PUBLIC_*): access
# control is enforced by Postgres Row Level Security, not by keeping this
# key secret. The service_role key must NEVER be used here or in any
# NEXT_PUBLIC_* variable — it is not part of this app's normal auth flow.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# Server-only variables below this line. NEVER prefix these with
# NEXT_PUBLIC_ — every one of them must stay out of the browser bundle.
# ---------------------------------------------------------------------

# Supabase Dashboard -> Project Settings -> API -> "service_role" /
# "secret" key. Bypasses Row Level Security entirely — used only by
# trusted server-only scripts/routes (scripts/meta-sync.mjs,
# scripts/meta-reprocess-lead.ts, app/api/meta/leadgen-webhook/route.ts),
# never by anything reachable from the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Meta permanent System User access token (Meta Business Settings ->
# System Users). Used read-only to derive a Page Access Token and fetch
# lead details — see lib/meta/graph.ts.
META_ACCESS_TOKEN=

# Comma-separated Meta ad account ids (act_...) for the daily campaign
# spend sync — see scripts/meta-sync.mjs.
META_AD_ACCOUNT_IDS=

# Meta App Secret (Meta App Dashboard -> Settings -> Basic). Required to
# verify the X-Hub-Signature-256 header on incoming Lead Ads webhook
# POSTs — see app/api/meta/leadgen-webhook/route.ts. Without this set,
# the webhook route fails closed (500) rather than trusting unverified
# payloads.
META_APP_SECRET=

# Arbitrary shared secret YOU choose and enter into the Meta Developer
# Dashboard's webhook subscription form (Verify Token field). Required
# to answer Meta's webhook verification GET request. Without this set,
# the webhook route's GET handler fails closed (500).
META_WEBHOOK_VERIFY_TOKEN=

# Arbitrary long random secret (e.g. `openssl rand -hex 32`) that
# authenticates every /api/cron/* scheduler (recurring-billing,
# recurring-business-expenses, follow-up-notifications — ONE shared
# secret, not one per route). Set this SAME value as a Vercel project
# environment variable (Production) named CRON_SECRET — Vercel then
# automatically sends it as "Authorization: Bearer <value>" on every
# scheduled request (see vercel.json's `crons` entries and
# lib/cron/auth.ts). Without this set — locally or in Vercel — every
# one of those routes fails closed (401/500) rather than accepting any
# caller.
CRON_SECRET=

# ---------------------------------------------------------------------
# Follow-up notification emails (app/api/cron/follow-up-notifications,
# lib/notifications/) — see docs/follow-up-notifications.md for the
# full manual setup walkthrough (Resend account + domain verification).
# ---------------------------------------------------------------------

# Resend (https://resend.com) API key — Resend Dashboard -> API Keys.
# Used only by lib/notifications/providers/resend.ts, server-side only,
# never exposed to the browser. Without this set, the follow-up
# reminder/digest cron fails closed for every candidate (logs a config
# error, sends nothing, claims nothing) rather than silently doing
# nothing unnoticed.
RESEND_API_KEY=

# The verified "From" address emails are sent as, e.g.
# "GAL CRM <reminders@yourdomain.com>". The domain must be verified in
# the Resend Dashboard (Domains -> Add Domain -> add the DNS records it
# gives you) before real delivery works reliably — see
# docs/follow-up-notifications.md.
EMAIL_FROM=

# Gal's own recipient address for reminder/digest emails. Deliberately
# NOT hardcoded anywhere in source — a private individual's email
# address must never be committed to the repo.
GAL_NOTIFICATION_EMAIL=

# Base URL used to build direct links to a Lead/Customer record inside
# notification emails, e.g. https://gal-crm.example.com (no trailing
# slash). Optional on Vercel — falls back to Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL if unset (see
# lib/notifications/env.ts) — but set explicitly if you want emails to
# always link to your real production domain rather than whatever
# Vercel deployment URL happened to build them.
APP_BASE_URL=
